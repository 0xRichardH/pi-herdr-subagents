    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "~1.3.0",
    "@earendil-works/pi-coding-agent": "~1.3.0",
    "@earendil-works/pi-tui": "~1.3.0",
    "@sinclair/typebox": "^0.34.52",
    "oxlint": "^1.73.0"
